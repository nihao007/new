dleware/coprocessor -I../middleware/mailbox -I../middleware/thirdparty/sysroot/include -I../middleware/thirdparty/sysroot/include/control_library -I../middleware/thirdparty/sysroot/include/fridge_control -I../middleware/thirdparty/sysroot/include/function_safety -I../middleware/thirdparty/sysroot/include/hisilicon -I../middleware/thirdparty/sysroot/include/improve_library -I../middleware/thirdparty/sysroot/include/no_open/ac_ref -I../middleware/thirdparty/sysroot/include/no_open/obs -I../user/adc -I../user/generatecode -I../user/motors -I../user/pid -I../user/uart
